NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://username:password@ep-example.neon.tech/database?sslmode=verify-full
SESSION_SECRET=ganti-dengan-secret-random-minimal-32-karakter
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
APP_BASE_URL=http://localhost:3000
EMAIL_MODE=disabled
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# SMTP_PASSWORD harus disediakan melalui protected secret, bukan Git.
# Seed hanya boleh dijalankan eksplisit di development; jangan aktifkan di production.
SEED_ENABLED=false
