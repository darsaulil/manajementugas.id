# E2E / isolated test database (NEVER point to production DATABASE_URL)
# Copy values to your local environment or a local-only env file; do not commit secrets.
TEST_DATABASE_URL=postgresql://username:password@ep-test-branch.neon.tech/testdb?sslmode=verify-full
E2E_PORT=3100
E2E_APP_BASE_URL=http://127.0.0.1:3100
EMAIL_MODE=test

# Known accounts present ONLY in the isolated test DB (from seed/migration setup there)
E2E_OWNER_LOGIN_ID=
E2E_OWNER_PASSWORD=
E2E_USER_LOGIN_ID=
E2E_USER_PASSWORD=
